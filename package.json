{
  "name": "signal-fracture",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:agent": "bun run --cwd apps/agent dev",
    "dev:web": "bun run --cwd apps/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --exclude 'tests/integration/**' --exclude 'tests/live/**'",
    "test:integration": "vitest run tests/integration",
    "test:live": "vitest run tests/live",
    "build": "bun run build:packages && bun run --cwd apps/agent build && bun run --cwd apps/web build",
    "build:packages": "tsc -b packages/shared packages/core packages/ai packages/caspian",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run test:integration && bun run build",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@signal-fracture/ai": "workspace:*",
    "@signal-fracture/core": "workspace:*",
    "@signal-fracture/shared": "workspace:*",
    "@types/node": "26.1.2",
    "convex": "1.42.3",
    "convex-test": "0.0.54",
    "eslint": "10.8.0",
    "next": "15.5.22",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
